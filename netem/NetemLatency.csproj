<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Wall-clock effect of HTTP/3 header size: Kestrel + HttpClient in one process over a netem-shaped loopback.
       Reuses the validated ".NET today" encoder model to size header blocks exactly. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS8632;CS1591;CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../dotnet/DotnetStyleEncoder.cs" />
    <Compile Include="../dotnet/HuffmanString.cs" />
    <Compile Include="../dotnet/StaticLookup.cs" />
    <Compile Include="../dotnet/Shims.cs" />
    <Compile Include="../dotnet-src/QPackEncoder.cs" />
    <Compile Include="../dotnet-src/QPackEncodingException.cs" />
    <Compile Include="../dotnet-src/H3StaticTable.cs" />
    <Compile Include="../dotnet-src/H3StaticTable.Http3.cs" />
    <Compile Include="../dotnet-src/HeaderField.cs" />
    <Compile Include="../dotnet-src/IntegerEncoder.cs" />
    <Compile Include="../dotnet-src/Huffman.cs" />
    <Compile Include="../dotnet-src/HuffmanDecodingException.cs" />
  </ItemGroup>

</Project>
